{
  "name": "ai-resume-generator",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --watch 'src/**/*.ts' --exec 'node --import tsx' src/index.ts",
    "debug": "nodemon --inspect --watch 'src/**/*.ts' --exec 'node --import tsx' src/index.ts",
    "build": "tsc",
    "dev-tsc": "tsc --watch",
    "ts-node": "ts-node -esm src/index.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "nodemon": "^3.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
