{
  "name": "ai-resume-generator",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --watch 'src/**/*.ts' --exec 'node --import tsx' src/index.ts",
    "debug": "nodemon --inspect --watch 'src/**/*.ts' --exec 'node --import tsx' src/index.ts",
    "build": "tsc",
    "dev-tsc": "tsc --watch",
    "ts-node": "ts-node -esm src/index.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.1.2",
    "node-fetch": "^3.3.2",
    "passport": "0.7.0",
    "passport-google-oauth20": "2.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.3",
    "nodemon": "^3.0.0",
    "prisma": "^5.10.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
